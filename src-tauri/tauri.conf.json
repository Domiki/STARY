{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STARY",
  "version": "0.1.0",
  "identifier": "dev.stary.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "STARY",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "backgroundColor": "#0b111b",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
